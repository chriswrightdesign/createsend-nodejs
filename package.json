{
  "name": "@create-send/node-js",
  "version": "0.1.0",
  "description": "Node.js SDK for the Campaign Monitor API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate.ts",
    "clean": "rimraf dist src/generated"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  }
}
